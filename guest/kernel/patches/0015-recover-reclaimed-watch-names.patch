+static bool ctrs_name_guard(void)
+{
+	struct ctrs_initial_listing *initial = kvzalloc(sizeof(*initial), GFP_KERNEL);
+	struct recovery_listing *recovery = kvzalloc(sizeof(*recovery), GFP_KERNEL);
+	char name[NAME_MAX + 2] = { 'x' };
+	bool ok = false;
+
+	if (initial && recovery &&
+	    ctrs_initial_emit(&initial->ctx, name, NAME_MAX + 1, 0, 1, DT_REG) &&
+	    recovery_emit(&recovery->ctx, name, NAME_MAX + 1, 0, 1, DT_REG) &&
+	    !initial->count && !recovery->count &&
+	    ctrs_initial_emit(&initial->ctx, name, 1, 0, 1, DT_REG) &&
+	    recovery_emit(&recovery->ctx, name, 1, 0, 1, DT_REG) &&
+	    initial->count == 1 && recovery->count == 1)
+		ok = true;
+	kvfree(initial);
+	kvfree(recovery);
+	return ok;
+}
