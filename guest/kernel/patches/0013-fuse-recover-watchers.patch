+int fuse_host_entry_state(struct dentry *entry)
+{
+	struct name_snapshot name;
+	struct dentry *parent;
+	unsigned int seq;
+	int ret;
+
+	do {
+		seq = read_seqcount_begin(&entry->d_seq);
+		parent = dget_parent(entry);
+		take_dentry_name_snapshot(&name, entry);
+		if (!read_seqcount_retry(&entry->d_seq, seq))
+			break;
+		release_dentry_name_snapshot(&name);
+		dput(parent);
+	} while (1);
+	ret = fuse_host_entry_state_at(entry, parent, &name.name, seq);
+	if (read_seqcount_retry(&entry->d_seq, seq))
+		ret = -EAGAIN;
+	release_dentry_name_snapshot(&name);
+	dput(parent);
+	return ret;
 }
 
