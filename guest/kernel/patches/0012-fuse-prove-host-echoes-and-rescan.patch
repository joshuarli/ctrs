+/*
+ * Whether a host notification for @entry reports only this guest's own
+ * change: 1 if the guest changed the inode and the host's entry maps the
+ * name to the same node with the cached (valid) size, mtime and ctime; 0
+ * if it is the same node but otherwise (the cached attributes are
+ * refreshed from the reply); -1 if the name now maps to another node or
+ * none, or the lookup failed.
+ */
+int fuse_host_entry_state(struct dentry *entry)
+{
+	struct inode *dir = d_inode(entry->d_parent);
+	struct inode *inode = d_inode(entry);
+	struct fuse_forget_link *forget;
+	struct fuse_entry_out outarg;
+	struct fuse_mount *fm;
+	struct fuse_inode *fi;
+	u64 attr_version;
+	FUSE_ARGS(args);
+	bool same;
+	int err;
+
+	if (entry->d_sb->s_magic != FUSE_SUPER_MAGIC || !inode ||
+	    fuse_is_bad(inode))
+		return -1;
+	fm = get_fuse_mount(inode);
+	fi = get_fuse_inode(inode);
+	forget = fuse_alloc_forget();
+	if (!forget)
+		return -1;
+	attr_version = fuse_get_attr_version(fm->fc);
+	fuse_lookup_init(fm->fc, &args, get_node_id(dir), &entry->d_name,
+			 &outarg);
+	err = fuse_simple_request(fm, &args);
+	if (err || !outarg.nodeid) {
+		kfree(forget);
+		return -1;
+	}
+	if (outarg.nodeid != get_node_id(inode) ||
+	    fuse_invalid_attr(&outarg.attr) ||
+	    fuse_stale_inode(inode, outarg.generation, &outarg.attr)) {
+		fuse_queue_forget(fm->fc, forget, outarg.nodeid, 1);
+		return -1;
+	}
+	spin_lock(&fi->lock);
+	fi->nlookup++;
+	spin_unlock(&fi->lock);
+	kfree(forget);
+	same = test_bit(FUSE_I_CHANGED_HERE, &fi->state) &&
+	       !(READ_ONCE(fi->inval_mask) &
+		 (STATX_SIZE | STATX_MTIME | STATX_CTIME)) &&
+	       outarg.attr.size == i_size_read(inode) &&
+	       outarg.attr.mtime == inode_get_mtime_sec(inode) &&
+	       outarg.attr.mtimensec == inode_get_mtime_nsec(inode) &&
+	       outarg.attr.ctime == inode_get_ctime_sec(inode) &&
+	       outarg.attr.ctimensec == inode_get_ctime_nsec(inode);
+	if (same)
+		return 1;
+	clear_bit(FUSE_I_CHANGED_HERE, &fi->state);
+	forget_all_cached_acls(inode);
+	fuse_change_attributes(inode, &outarg.attr, NULL,
+			       ATTR_TIMEOUT(&outarg), attr_version);
+	fuse_change_entry_timeout(entry, &outarg);
+	return 0;
 }
 
+/*
+ * The host could not vouch for its change notifications (they were
+ * coalesced or dropped): every cached dentry is revalidated with the host
+ * on its next use.
+ */
+void fuse_host_rescan(struct inode *inode)
+{
+	struct fuse_conn *fc;
+
+	if (inode->i_sb->s_magic != FUSE_SUPER_MAGIC)
+		return;
+	fc = get_fuse_conn(inode);
+	atomic_inc(&fc->epoch);
+	pr_info_ratelimited("ctrs: host change notifications were lost; virtiofs caches dropped\n");
+}
