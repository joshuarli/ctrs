+/* -1: not known here; 0: same node, changed and raised; 1: own change. */
+static int notify_known(struct dentry *dir, const char *name, char kind)
+{
+	struct dentry *child = try_lookup_noperm(&QSTR(name), dir);
+	int state = -1;
+
+	if (IS_ERR_OR_NULL(child))
+		return -1;
+	if (d_really_is_negative(child)) {
+		state = kind == 'r' ? 1 : -1;
+	} else if (kind != 'r') {
+		state = fuse_host_entry_state(child);
+		if (state == 0) {
+			struct inode *inode = d_inode(child);
+
+			if (S_ISREG(inode->i_mode)) {
+				invalidate_mapping_pages(inode->i_mapping, 0, -1);
+				notify_renamed_in_place(d_inode(dir), child);
+			}
+			fsnotify_change(child, ATTR_SIZE);
+		}
+	}
+	dput(child);
+	return state;
+}
