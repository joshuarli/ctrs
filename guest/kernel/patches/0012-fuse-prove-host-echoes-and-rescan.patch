+static int notify_rescan(char *full)
+{
+	struct path p;
+	char *end = full + strlen(full);
+	int err = kern_path(full, LOOKUP_FOLLOW | LOOKUP_DIRECTORY, &p);
+
+	while (err == -ENOENT && end > full + 1) {
+		while (--end > full && *end != '/')
+			;
+		if (end == full)
+			break;
+		*end = '\0';
+		err = kern_path(full, LOOKUP_FOLLOW | LOOKUP_DIRECTORY, &p);
+	}
+	if (err)
+		return err;
+	fuse_host_rescan(d_inode(p.dentry));
+	fsnotify_inode(d_inode(p.dentry), FS_ATTRIB);
+	path_put(&p);
+	return 0;
+}
