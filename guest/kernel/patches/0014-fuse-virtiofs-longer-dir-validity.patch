# Header: Apple's virtiofs server grants about one second of entry and
# attribute validity, so every path walk revalidates each directory
# component once a second (about 40% of npm install LOOKUPs). On
# virtiofs, directory dentries and directory attributes stay valid for
# at least ten seconds. The Mac's changes under bind sources reach the
# guest through /proc/ctrs/fsnotify (patch 0006), which drops the
# attributes of the directory an event names (since 0013) and now also
# expires a named directory's dentry, which it cannot invalidate
# outright because mounts may sit beneath it.
diff -ru a/fs/fuse/dir.c b/fs/fuse/dir.c
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -106,14 +106,24 @@
 		return 0;
 }
 
+#define FUSE_VIRTIOFS_DIR_VALID (10 * HZ)
+
+u64 fuse_dir_valid_until(struct inode *inode, u64 time)
+{
+	if (inode && S_ISDIR(inode->i_mode) &&
+	    !strcmp(inode->i_sb->s_type->name, "virtiofs"))
+		return max(time, get_jiffies_64() + FUSE_VIRTIOFS_DIR_VALID);
+	return time;
+}
+
 /*
  * Set dentry and possibly attribute timeouts from the lookup/mk*
  * replies
  */
 void fuse_change_entry_timeout(struct dentry *entry, struct fuse_entry_out *o)
 {
-	fuse_dentry_settime(entry,
-		fuse_time_to_jiffies(o->entry_valid, o->entry_valid_nsec));
+	fuse_dentry_settime(entry, fuse_dir_valid_until(d_inode(entry),
+		fuse_time_to_jiffies(o->entry_valid, o->entry_valid_nsec)));
 }
 
 void fuse_invalidate_attr_mask(struct inode *inode, u32 mask)
@@ -168,6 +178,15 @@
 	fuse_invalidate_attr(dir);
 }
 
+void fuse_host_changed_entry(struct dentry *entry)
+{
+	if (entry->d_sb->s_magic != FUSE_SUPER_MAGIC)
+		return;
+	fuse_invalidate_entry_cache(entry);
+	if (d_really_is_positive(entry))
+		fuse_invalidate_attr(d_inode(entry));
+}
+
 static void fuse_dir_changed(struct inode *dir)
 {
 	fuse_mark_local_change(dir);
