+#define FUSE_BUILT_HERE_WINDOW (10 * HZ)
+
+static bool fuse_built_here(struct inode *dir)
+{
+	unsigned long t = READ_ONCE(get_fuse_inode(dir)->built_here);
+
+	return t && time_before(jiffies, t + FUSE_BUILT_HERE_WINDOW);
+}
+
+static void fuse_forget_built_here(struct inode *dir)
+{
+	if (dir && READ_ONCE(get_fuse_inode(dir)->built_here))
+		WRITE_ONCE(get_fuse_inode(dir)->built_here, 0);
+}
+
+void fuse_host_changed_dir(struct inode *dir)
+{
+	if (dir->i_sb->s_magic != FUSE_SUPER_MAGIC)
+		return;
+	fuse_forget_built_here(dir);
+	fuse_invalidate_attr(dir);
+}
