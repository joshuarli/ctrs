+
+/*
+ * The virtiofs server in Apple's Virtualization.framework holds one host file
+ * descriptor per inode the guest has looked up until FUSE_FORGET, so cached
+ * inodes consume the host's per-process and system-wide file limits.
+ */
+#define FUSE_PRUNE_BATCH 1024
+
+static atomic_long_t fuse_live_inodes = ATOMIC_LONG_INIT(0);
+static atomic_long_t fuse_evicted_inodes = ATOMIC_LONG_INIT(0);
+static unsigned long fuse_inode_cap = 65536;
+static unsigned long fuse_prune_idle_until = INITIAL_JIFFIES;
+static struct file_system_type *fuse_bounded_type;
+
+static unsigned long fuse_prune_target(unsigned long cap)
+{
+	return cap - cap / 8;
+}
+
+static void fuse_prune_sb(struct super_block *sb, void *arg)
+{
+	if (sb->s_fs_info && get_fuse_conn_super(sb)->bounded_inodes)
+		shrink_dcache_sb_unused(sb, FUSE_PRUNE_BATCH);
+}
+
+static void fuse_prune_run(struct work_struct *work)
+{
+	unsigned int idle = 0;
+
+	for (;;) {
+		struct file_system_type *type = READ_ONCE(fuse_bounded_type);
+		unsigned long cap = READ_ONCE(fuse_inode_cap);
+		long evicted = atomic_long_read(&fuse_evicted_inodes);
+
+		if (!type || !cap ||
+		    atomic_long_read(&fuse_live_inodes) <= fuse_prune_target(cap))
+			break;
+		iterate_supers_type(type, fuse_prune_sb, NULL);
+		if (atomic_long_read(&fuse_evicted_inodes) != evicted) {
+			idle = 0;
+		} else if (++idle == 2) {
+			WRITE_ONCE(fuse_prune_idle_until, jiffies + HZ);
+			break;
+		}
+		cond_resched();
+	}
+}
+
+static DECLARE_WORK(fuse_prune_work, fuse_prune_run);
+
+static void fuse_prune_kick(bool now)
+{
+	if (now)
+		WRITE_ONCE(fuse_prune_idle_until, jiffies);
+	else if (time_before(jiffies, READ_ONCE(fuse_prune_idle_until)))
+		return;
+	queue_work(system_unbound_wq, &fuse_prune_work);
+}
+
+void fuse_set_bounded_fs_type(struct file_system_type *type)
+{
+	WRITE_ONCE(fuse_bounded_type, type);
+	if (!type)
+		cancel_work_sync(&fuse_prune_work);
 }
+EXPORT_SYMBOL_GPL(fuse_set_bounded_fs_type);
 
+static void fuse_count_inode(struct inode *inode)
+{
+	unsigned long cap = READ_ONCE(fuse_inode_cap);
+
+	set_bit(FUSE_I_BOUNDED, &get_fuse_inode(inode)->state);
+	if (atomic_long_inc_return(&fuse_live_inodes) > cap && cap)
+		fuse_prune_kick(false);
+}
+
+static ssize_t fuse_inodes_read(struct file *file, char __user *buf,
+				size_t count, loff_t *ppos)
+{
+	char text[48];
+	int len = scnprintf(text, sizeof(text), "%ld %lu\n",
+			    atomic_long_read(&fuse_live_inodes),
+			    READ_ONCE(fuse_inode_cap));
+
+	return simple_read_from_buffer(buf, count, ppos, text, len);
+}
+
+static ssize_t fuse_inodes_write(struct file *file, const char __user *buf,
+				 size_t count, loff_t *ppos)
+{
+	unsigned long cap;
+	int err;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	err = kstrtoul_from_user(buf, count, 10, &cap);
+	if (err)
+		return err;
+	WRITE_ONCE(fuse_inode_cap, cap);
+	if (cap && atomic_long_read(&fuse_live_inodes) > cap)
+		fuse_prune_kick(true);
+	return count;
+}
+
+static const struct proc_ops fuse_inodes_ops = {
+	.proc_read = fuse_inodes_read,
+	.proc_write = fuse_inodes_write,
+	.proc_lseek = default_llseek,
+};
+
 static void fuse_evict_inode(struct inode *inode)
 {
 	struct fuse_inode *fi = get_fuse_inode(inode);
+
+	if (test_and_clear_bit(FUSE_I_BOUNDED, &fi->state)) {
+		atomic_long_dec(&fuse_live_inodes);
+		atomic_long_inc(&fuse_evicted_inodes);
+	}
 
 	/* Will write inode on close/munmap and in all other dirtiers */
 	WARN_ON(inode->i_state & I_DIRTY_INODE);
@@ -511,6 +629,8 @@
 			inode->i_flags |= S_NOCMTIME;
 		inode->i_generation = generation;
 		fuse_init_inode(inode, attr, fc);
+		if (fc->bounded_inodes)
+			fuse_count_inode(inode);
 		unlock_new_inode(inode);
 	} else if (fuse_stale_inode(inode, generation, attr)) {
 		/* nodeid was reused, any I/O on the old inode should fail */
@@ -2298,6 +2418,8 @@
 
