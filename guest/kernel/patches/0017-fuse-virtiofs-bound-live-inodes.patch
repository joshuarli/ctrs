 	sanitize_global_limit(&max_user_congthresh);
+	if (!proc_create("ctrs/fuse_inodes", 0644, NULL, &fuse_inodes_ops))
+		pr_warn("cannot create /proc/ctrs/fuse_inodes\n");
 
 	return 0;
 
