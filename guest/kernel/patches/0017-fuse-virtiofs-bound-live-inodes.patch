# Header: Virtualization.framework's virtiofs server keeps one host file
# descriptor open for every inode the guest holds a lookup on, until the
# guest sends FUSE_FORGET. A guest with ample memory never reclaims its
# dcache, so walking a large bind mount pinned one host descriptor per file
# and exhausted the Mac's per-process and system-wide file limits. Live
# virtiofs inodes are now counted; above the bound (65536 by default,
# /proc/ctrs/fuse_inodes reads "live bound" and accepts a new bound, 0
# disables it) a work item prunes unused dentries LRU-first until the count
# is 7/8 of the bound. FUSE drops inodes on their last reference, so each
# pruned dentry evicts its inode and sends FUSE_FORGET. Dentries in use
# (open files, cwd, mounts) and inodes pinned by watches are never pruned.
# Each memory cgroup's dentry list gets its own budget per pass, so one
# cgroup's list cannot starve another's. Pruning visits only virtiofs
# superblocks, so another filesystem's mount or unmount cannot stall it.
--- a/fs/dcache.c
+++ b/fs/dcache.c
@@ -32,6 +32,7 @@
 #include <linux/bit_spinlock.h>
 #include <linux/rculist_bl.h>
 #include <linux/list_lru.h>
+#include <linux/memcontrol.h>
 #include "internal.h"
 #include "mount.h"
 
@@ -1262,7 +1263,27 @@
 	} while (list_lru_count(&sb->s_dentry_lru) > 0);
 }
 EXPORT_SYMBOL(shrink_dcache_sb);
+
+void shrink_dcache_sb_unused(struct super_block *sb, unsigned long nr)
+{
+	struct mem_cgroup *memcg = mem_cgroup_iter(NULL, NULL, NULL);
+
+	do {
+		int nid;
 
+		for_each_node_state(nid, N_NORMAL_MEMORY) {
+			LIST_HEAD(dispose);
+			unsigned long walk = nr;
+
+			list_lru_walk_one(&sb->s_dentry_lru, nid, memcg,
+					  dentry_lru_isolate, &dispose, &walk);
+			shrink_dentry_list(&dispose);
+		}
+		cond_resched();
+	} while ((memcg = mem_cgroup_iter(NULL, memcg, NULL)));
+}
+EXPORT_SYMBOL_GPL(shrink_dcache_sb_unused);
+
