+static struct ctrs_watch *ctrs_find_watch(struct inode *inode)
+{
+	struct ctrs_watch *watch;
+
+	hash_for_each_possible(ctrs_watches, watch, hash, (unsigned long)inode) {
+		if (watch->inode == inode)
+			return watch;
+	}
+	return NULL;
+}
+
+static int ctrs_name_cmp(const struct qstr *name, struct ctrs_pin *pin)
+{
+	int cmp = memcmp(name->name, pin->name, min(name->len, pin->len));
+
+	if (cmp)
+		return cmp;
+	return (name->len > pin->len) - (name->len < pin->len);
+}
+
+static struct ctrs_pin *ctrs_find_pin(struct ctrs_watch *watch, const struct qstr *name)
+{
+	struct rb_node *node = watch->pins.rb_node;
+
+	while (node) {
+		struct ctrs_pin *pin = rb_entry(node, struct ctrs_pin, node);
+		int cmp = ctrs_name_cmp(name, pin);
+
+		if (!cmp)
+			return pin;
+		node = cmp < 0 ? node->rb_left : node->rb_right;
+	}
+	return NULL;
+}
+
+static int ctrs_pin_locked(struct ctrs_watch *watch, struct dentry *child,
+			   const struct qstr *name, struct dentry **old_entry,
+			   struct ctrs_pin **candidate)
+{
+	struct rb_node **link = &watch->pins.rb_node, *parent = NULL;
+	struct ctrs_pin *pin;
+	struct inode *inode;
+	struct timespec64 mtime, ctime;
+	loff_t size;
+
+	spin_lock(&child->d_lock);
+	inode = d_inode(child);
+	if (inode) {
+		size = i_size_read(inode);
+		mtime = inode_get_mtime(inode);
+		ctime = inode_get_ctime(inode);
+	}
+	spin_unlock(&child->d_lock);
+	if (!inode)
+		return 0;
+	while (*link) {
+		int cmp;
+
+		parent = *link;
+		pin = rb_entry(parent, struct ctrs_pin, node);
+		cmp = ctrs_name_cmp(name, pin);
+		if (!cmp) {
+			if (pin->entry != child) {
+				*old_entry = pin->entry;
+				pin->entry = dget(child);
+			}
+			pin->size = size;
+			pin->mtime = mtime;
+			pin->ctime = ctime;
+			return 0;
+		}
+		link = cmp < 0 ? &parent->rb_left : &parent->rb_right;
+	}
+	pin = *candidate;
+	if (!pin)
+		return -ENOMEM;
+	*candidate = NULL;
+	pin->entry = dget(child);
+	pin->len = name->len;
+	memcpy(pin->name, name->name, name->len);
+	pin->name[name->len] = '\0';
+	pin->size = size;
+	pin->mtime = mtime;
+	pin->ctime = ctime;
+	rb_link_node(&pin->node, parent, link);
+	rb_insert_color(&pin->node, &watch->pins);
+	return 0;
+}
+
+static struct dentry *ctrs_unpin_locked(struct ctrs_watch *watch, const struct qstr *name)
+{
+	struct ctrs_pin *pin = ctrs_find_pin(watch, name);
+	struct dentry *entry;
+
+	if (!pin)
+		return NULL;
+	rb_erase(&pin->node, &watch->pins);
+	entry = pin->entry;
+	kfree(pin);
+	return entry;
+}
+
+struct ctrs_initial_listing {
+	struct dir_context ctx;
+	unsigned int count;
+	struct recovery_name names[RECOVERY_BATCH];
+};
+
+static bool ctrs_initial_emit(struct dir_context *ctx, const char *name,
+			      int len, loff_t offset, u64 ino, unsigned int type)
+{
+	struct ctrs_initial_listing *listing = container_of(ctx, struct ctrs_initial_listing, ctx);
+	struct recovery_name *item;
+
+	if ((len == 1 && name[0] == '.') ||
+	    (len == 2 && name[0] == '.' && name[1] == '.'))
+		return true;
+	if (len > NAME_MAX || listing->count == RECOVERY_BATCH)
+		return false;
+	item = &listing->names[listing->count++];
+	item->len = len;
+	memcpy(item->name, name, len);
+	item->name[len] = '\0';
+	return true;
+}
+
+static int ctrs_watch_populate(struct ctrs_watch *watch)
+{
+	struct ctrs_initial_listing *listing;
+	struct file *file;
+	int err = 0;
+
+	if (!S_ISDIR(watch->inode->i_mode))
+		return 0;
+	file = dentry_open_nonotify(&watch->path, O_RDONLY | O_DIRECTORY, current_cred());
+	if (IS_ERR(file))
+		return PTR_ERR(file);
+	listing = kvzalloc(sizeof(*listing), GFP_KERNEL);
+	if (!listing) {
+		fput(file);
+		return -ENOMEM;
+	}
+	do {
+		loff_t before = file->f_pos;
+		unsigned int i;
+
+		listing->ctx.actor = ctrs_initial_emit;
+		listing->ctx.count = PAGE_SIZE;
+		listing->count = 0;
+		err = iterate_dir(file, &listing->ctx);
+		for (i = 0; !err && i < listing->count; i++) {
+			struct recovery_name *name = &listing->names[i];
+			struct qstr q = QSTR_LEN(name->name, name->len);
+			struct dentry *child, *old_entry = NULL;
+			struct ctrs_pin *candidate;
+
+			q.hash = full_name_hash(watch->path.dentry, name->name, name->len);
+			child = lookup_noperm_unlocked(&q, watch->path.dentry);
+			if (IS_ERR(child)) {
+				if (PTR_ERR(child) == -ENOENT)
+					continue;
+				err = PTR_ERR(child);
+				break;
+			}
+			candidate = kmalloc(sizeof(*candidate) + q.len + 1, GFP_NOFS | __GFP_ACCOUNT | __GFP_RETRY_MAYFAIL);
+			mutex_lock(&ctrs_watch_mutex);
+			err = ctrs_pin_locked(watch, child, &q, &old_entry, &candidate);
+			mutex_unlock(&ctrs_watch_mutex);
+			kfree(candidate);
+			dput(old_entry);
+			dput(child);
+		}
+		if (err || before == file->f_pos)
+			break;
+		cond_resched();
+	} while (1);
+	kvfree(listing);
+	fput(file);
+	return err;
+}
+
+static void ctrs_watch_free_mark(struct fsnotify_mark *mark)
+{
+	struct ctrs_watch *watch = container_of(mark, struct ctrs_watch, mark);
+	struct rb_node *node;
+	unsigned int count = 0;
+
+	while ((node = rb_first(&watch->pins))) {
+		struct ctrs_pin *pin = rb_entry(node, struct ctrs_pin, node);
+
+		rb_erase(node, &watch->pins);
+		dput(pin->entry);
+		kfree(pin);
+		if (++count == RECOVERY_BATCH) {
+			count = 0;
+			cond_resched();
+		}
+	}
+	path_put(&watch->path);
+	mem_cgroup_put(watch->memcg);
+	kfree(watch);
+}
+
+void ctrs_watch_put(struct ctrs_watch *watch)
+{
+	if (!watch)
+		return;
+	mutex_lock(&ctrs_watch_mutex);
+	if (--watch->refs) {
+		mutex_unlock(&ctrs_watch_mutex);
+		return;
+	}
+	hash_del(&watch->hash);
+	mutex_unlock(&ctrs_watch_mutex);
+	fsnotify_destroy_mark(&watch->mark, ctrs_watch_group);
+	fsnotify_put_mark(&watch->mark);
+}
+
+struct ctrs_watch *ctrs_watch_get(struct path *path)
+{
+	struct ctrs_watch *watch, *candidate;
+	struct inode *inode = d_inode(path->dentry);
+	bool created = false;
+	int err;
+
+	if (strcmp(inode->i_sb->s_type->name, "virtiofs"))
+		return NULL;
+	if (!ctrs_watch_group)
+		return ERR_PTR(-ENODEV);
+	candidate = kzalloc(sizeof(*candidate), GFP_KERNEL_ACCOUNT | __GFP_RETRY_MAYFAIL);
+	if (!candidate)
+		return ERR_PTR(-ENOMEM);
+	mutex_lock(&ctrs_watch_mutex);
+	watch = ctrs_find_watch(inode);
+	if (watch) {
+		watch->refs++;
+	} else {
+		watch = candidate;
+		candidate = NULL;
+		watch->memcg = get_mem_cgroup_from_mm(current->mm);
+		watch->path = *path;
+		path_get(&watch->path);
+		watch->inode = inode;
+		watch->size = i_size_read(inode);
+		watch->mtime = inode_get_mtime(inode);
+		watch->ctime = inode_get_ctime(inode);
+		watch->pins = RB_ROOT;
+		watch->refs = 1;
+		init_completion(&watch->ready);
+		fsnotify_init_mark(&watch->mark, ctrs_watch_group);
+		watch->mark.mask = FS_CREATE | FS_DELETE | FS_MOVED_FROM | FS_MOVED_TO |
+				   FS_MODIFY | FS_ATTRIB | FS_CLOSE_WRITE | FS_DELETE_SELF |
+				   FS_MOVE_SELF | FS_EVENT_ON_CHILD;
+		hash_add(ctrs_watches, &watch->hash, (unsigned long)inode);
+		created = true;
+	}
+	mutex_unlock(&ctrs_watch_mutex);
+	kfree(candidate);
+	if (created) {
+		err = fsnotify_add_inode_mark(&watch->mark, inode, 0);
+		if (!err)
+			err = ctrs_watch_populate(watch);
+		watch->error = err;
+		complete_all(&watch->ready);
+	} else {
+		wait_for_completion(&watch->ready);
+	}
+	if (watch->error) {
+		int err = watch->error;
+
+		ctrs_watch_put(watch);
+		return ERR_PTR(err);
+	}
+	return watch;
+}
+
+static void ctrs_watch_event(struct inode *dir, const struct qstr *name, u32 mask,
+		      struct inode *inode)
+{
+	struct ctrs_watch *watch;
+	struct dentry *child = NULL, *old_entry = NULL;
+	struct ctrs_pin *candidate = NULL;
+
+	if (!name && inode && !strcmp(inode->i_sb->s_type->name, "virtiofs")) {
+		mutex_lock(&ctrs_watch_mutex);
+		watch = ctrs_find_watch(inode);
+		if (watch) {
+			watch->size = i_size_read(inode);
+			watch->mtime = inode_get_mtime(inode);
+			watch->ctime = inode_get_ctime(inode);
+		}
+		mutex_unlock(&ctrs_watch_mutex);
+	}
+	if (!dir || !name || strcmp(dir->i_sb->s_type->name, "virtiofs"))
+		return;
+	if (!(mask & (FS_CREATE | FS_DELETE | FS_MOVED_FROM | FS_MOVED_TO |
+		     FS_MODIFY | FS_ATTRIB | FS_CLOSE_WRITE)))
+		return;
+	if (!(mask & (FS_DELETE | FS_MOVED_FROM)))
+		candidate = kmalloc(sizeof(*candidate) + name->len + 1, GFP_NOFS | __GFP_ACCOUNT | __GFP_RETRY_MAYFAIL);
+	mutex_lock(&ctrs_watch_mutex);
+	watch = ctrs_find_watch(dir);
+	if (watch) {
+		if (mask & (FS_DELETE | FS_MOVED_FROM)) {
+			old_entry = ctrs_unpin_locked(watch, name);
+		} else {
+			child = d_lookup(watch->path.dentry, name);
+			if (child && ctrs_pin_locked(watch, child, name, &old_entry, &candidate))
+				pr_warn_ratelimited("ctrs: cannot retain watched name\n");
+		}
+	}
+	mutex_unlock(&ctrs_watch_mutex);
+	kfree(candidate);
+	dput(old_entry);
+	dput(child);
+}
+
+static int ctrs_watch_handle(struct fsnotify_mark *mark, u32 mask,
+			     struct inode *inode, struct inode *dir,
+			     const struct qstr *name, u32 cookie)
+{
+	struct ctrs_watch *watch = container_of(mark, struct ctrs_watch, mark);
+	struct mem_cgroup *old_memcg = set_active_memcg(watch->memcg);
+
+	if (inode && watch->inode == inode)
+		ctrs_watch_event(NULL, NULL, mask, inode);
+	if (name && dir && watch->inode == dir)
+		ctrs_watch_event(dir, name, mask, inode);
+	set_active_memcg(old_memcg);
+	return 0;
+}
+
+static const struct fsnotify_ops ctrs_watch_ops = {
+	.handle_inode_event = ctrs_watch_handle,
+	.free_mark = ctrs_watch_free_mark,
+};
+
+static bool ctrs_watch_changed(struct inode *dir, const struct qstr *name, struct inode *inode)
+{
+	struct ctrs_watch *watch;
+	struct ctrs_pin *pin;
+	struct timespec64 mtime = inode_get_mtime(inode), ctime = inode_get_ctime(inode);
+	bool changed = false;
+
+	mutex_lock(&ctrs_watch_mutex);
+	watch = ctrs_find_watch(inode);
+	if (watch && !S_ISDIR(inode->i_mode))
+		changed = watch->size != i_size_read(inode) ||
+			  !timespec64_equal(&watch->mtime, &mtime) ||
+			  !timespec64_equal(&watch->ctime, &ctime);
+	watch = ctrs_find_watch(dir);
+	pin = watch ? ctrs_find_pin(watch, name) : NULL;
+	if (pin)
+		changed |= pin->size != i_size_read(inode) ||
+			   !timespec64_equal(&pin->mtime, &mtime) ||
+			   !timespec64_equal(&pin->ctime, &ctime);
+	mutex_unlock(&ctrs_watch_mutex);
+	return changed;
+}
 
+static bool ctrs_watch_tracked(struct inode *dir, const struct qstr *name,
+			       struct dentry *entry)
+{
+	struct ctrs_watch *watch;
+	struct ctrs_pin *pin;
+	struct inode *inode = d_inode(entry);
+	bool found = false;
+
+	mutex_lock(&ctrs_watch_mutex);
+	watch = inode ? ctrs_find_watch(inode) : NULL;
+	if (watch && watch->path.dentry == entry)
+		found = true;
+	watch = ctrs_find_watch(dir);
+	pin = watch ? ctrs_find_pin(watch, name) : NULL;
+	if (pin && pin->entry == entry)
+		found = true;
+	mutex_unlock(&ctrs_watch_mutex);
+	return found;
+}
