+struct ctrs_name {
+	struct rb_node node;
+	u64 ino;
+	u64 seen;
+	bool touched;
+	bool removed;
+	unsigned char type;
+	unsigned int len;
+	char name[];
+};
+
+struct ctrs_watch {
+	struct hlist_node hash;
+	struct fsnotify_mark mark;
+	struct inode *inode;
+	struct mutex lock;
+	struct rb_root names;
+	struct completion ready;
+	unsigned int refs;
+	u64 generation;
+	bool populating;
+	bool degraded;
+	int error;
+};
+
+static DEFINE_MUTEX(ctrs_watch_mutex);
+static DEFINE_HASHTABLE(ctrs_watches, 8);
+static struct fsnotify_group *ctrs_watch_group;
+static const struct fsnotify_ops ctrs_watch_ops;
+static atomic_long_t ctrs_name_bytes = ATOMIC_LONG_INIT(0);
+static unsigned long ctrs_name_limit;
+
+static struct ctrs_watch *ctrs_find_watch(struct inode *inode)
+{
+	struct ctrs_watch *watch;
+
+	hash_for_each_possible(ctrs_watches, watch, hash, (unsigned long)inode) {
+		if (watch->inode == inode)
+			return watch;
+	}
+	return NULL;
+}
+
+static int ctrs_name_cmp(const struct qstr *name, const struct ctrs_name *item)
+{
+	int cmp = memcmp(name->name, item->name, min(name->len, item->len));
+
+	if (cmp)
+		return cmp;
+	return (name->len > item->len) - (name->len < item->len);
+}
+
+static struct ctrs_name *ctrs_find_name(struct ctrs_watch *watch, const struct qstr *name)
+{
+	struct rb_node *node = watch->names.rb_node;
+
+	while (node) {
+		struct ctrs_name *item = rb_entry(node, struct ctrs_name, node);
+		int cmp = ctrs_name_cmp(name, item);
+
+		if (!cmp)
+			return item;
+		node = cmp < 0 ? node->rb_left : node->rb_right;
+	}
+	return NULL;
+}
+
+static void ctrs_name_free(struct ctrs_name *item)
+{
+	atomic_long_sub(ksize(item), &ctrs_name_bytes);
+	kfree(item);
+}
+
+static void ctrs_degrade_locked(struct ctrs_watch *watch)
+{
+	struct rb_node *node;
+
+	if (watch->degraded)
+		return;
+	watch->degraded = true;
+	pr_warn_once("ctrs: watched directory name retention exhausted; recovery will overflow\n");
+	while ((node = rb_first(&watch->names))) {
+		struct ctrs_name *item = rb_entry(node, struct ctrs_name, node);
+
+		rb_erase(node, &watch->names);
+		ctrs_name_free(item);
+	}
+}
+
+static struct ctrs_name *ctrs_name_add_locked(struct ctrs_watch *watch, const struct qstr *name, u64 ino, unsigned int type, bool initial)
+{
+	struct rb_node **link = &watch->names.rb_node, *parent = NULL;
+	struct ctrs_name *item;
+	struct qstr key = QSTR_LEN(name->name, READ_ONCE(name->len));
+	unsigned int len = key.len;
+	unsigned long bytes;
+	long used;
+
+	if (watch->degraded)
+		return NULL;
+	while (*link) {
+		int cmp;
+
+		parent = *link;
+		item = rb_entry(parent, struct ctrs_name, node);
+		cmp = ctrs_name_cmp(&key, item);
+		if (!cmp) {
+			if (initial && item->touched)
+				return item;
+			if (ino)
+				item->ino = ino;
+			if (type != DT_UNKNOWN)
+				item->type = type;
+			if (!initial && watch->populating)
+				item->touched = true;
+			item->removed = false;
+			item->seen = watch->generation;
+			return item;
+		}
+		link = cmp < 0 ? &parent->rb_left : &parent->rb_right;
+	}
+	item = kmalloc(sizeof(*item) + len + 1, GFP_NOFS | __GFP_NOWARN);
+	if (!item) {
+		ctrs_degrade_locked(watch);
+		return NULL;
+	}
+	bytes = ksize(item);
+	used = atomic_long_read(&ctrs_name_bytes);
+	for (;;) {
+		if (bytes > ctrs_name_limit || used > ctrs_name_limit - bytes) {
+			kfree(item);
+			ctrs_degrade_locked(watch);
+			return NULL;
+		}
+		if (atomic_long_try_cmpxchg(&ctrs_name_bytes, &used, used + bytes))
+			break;
+	}
+	item->len = len;
+	item->ino = ino;
+	item->type = type;
+	item->touched = !initial && watch->populating;
+	item->removed = false;
+	item->seen = watch->generation;
+	memcpy(item->name, key.name, len);
+	item->name[len] = '\0';
+	rb_link_node(&item->node, parent, link);
+	rb_insert_color(&item->node, &watch->names);
+	return item;
+}
+
+static void ctrs_name_remove_locked(struct ctrs_watch *watch, const struct qstr *name)
+{
+	struct ctrs_name *item = ctrs_find_name(watch, name);
+
+	if (item) {
+		rb_erase(&item->node, &watch->names);
+		ctrs_name_free(item);
+	}
+}
+
+struct ctrs_initial_listing {
+	struct dir_context ctx;
+	unsigned int count;
+	struct { struct recovery_name name; u64 ino; } names[RECOVERY_BATCH];
+};
+
+static bool ctrs_initial_emit(struct dir_context *ctx, const char *name,
+			      int len, loff_t offset, u64 ino, unsigned int type)
+{
+	struct ctrs_initial_listing *listing = container_of(ctx, struct ctrs_initial_listing, ctx);
+	struct recovery_name *item;
+
+	if ((len == 1 && name[0] == '.') ||
+	    (len == 2 && name[0] == '.' && name[1] == '.'))
+		return true;
+	if (len > NAME_MAX || listing->count == RECOVERY_BATCH)
+		return false;
+	item = &listing->names[listing->count].name;
+	listing->names[listing->count++].ino = ino;
+	item->len = len;
+	item->type = type;
+	memcpy(item->name, name, len);
+	item->name[len] = '\0';
+	return true;
+}
+
+static void ctrs_watch_populate(struct ctrs_watch *watch, struct path *path)
+{
+	struct ctrs_initial_listing *listing;
+	struct file *file;
+	int err = 0;
+
+	if (!S_ISDIR(watch->inode->i_mode))
+		return;
+	file = dentry_open_nonotify(path, O_RDONLY | O_DIRECTORY, current_cred());
+	if (IS_ERR(file)) {
+		mutex_lock(&watch->lock);
+		ctrs_degrade_locked(watch);
+		mutex_unlock(&watch->lock);
+		return;
+	}
+	listing = kvzalloc(sizeof(*listing), GFP_KERNEL);
+	if (!listing) {
+		mutex_lock(&watch->lock);
+		ctrs_degrade_locked(watch);
+		mutex_unlock(&watch->lock);
+		fput(file);
+		return;
+	}
+	do {
+		loff_t before = file->f_pos;
+		unsigned int i;
+
+		listing->ctx.actor = ctrs_initial_emit;
+		listing->ctx.count = PAGE_SIZE;
+		listing->count = 0;
+		err = iterate_dir(file, &listing->ctx);
+		mutex_lock(&watch->lock);
+		for (i = 0; !err && i < listing->count; i++) {
+			struct recovery_name *name = &listing->names[i].name;
+			struct qstr q = QSTR_LEN(name->name, name->len);
+
+			ctrs_name_add_locked(watch, &q, listing->names[i].ino, name->type, true);
+		}
+		if (err)
+			ctrs_degrade_locked(watch);
+		mutex_unlock(&watch->lock);
+		if (err || before == file->f_pos || READ_ONCE(watch->degraded))
+			break;
+		cond_resched();
+	} while (1);
+	kvfree(listing);
+	fput(file);
+}
+
+static void ctrs_watch_free_mark(struct fsnotify_mark *mark)
+{
+	struct ctrs_watch *watch = container_of(mark, struct ctrs_watch, mark);
+	struct rb_node *node;
+
+	while ((node = rb_first(&watch->names))) {
+		struct ctrs_name *item = rb_entry(node, struct ctrs_name, node);
+
+		rb_erase(node, &watch->names);
+		ctrs_name_free(item);
+	}
+	kfree(watch);
+}
+
+void ctrs_watch_put(struct ctrs_watch *watch)
+{
+	if (!watch)
+		return;
+	mutex_lock(&ctrs_watch_mutex);
+	if (--watch->refs) {
+		mutex_unlock(&ctrs_watch_mutex);
+		return;
+	}
+	hash_del(&watch->hash);
+	mutex_unlock(&ctrs_watch_mutex);
+	fsnotify_destroy_mark(&watch->mark, ctrs_watch_group);
+	fsnotify_put_mark(&watch->mark);
+}
+
+static struct ctrs_watch *ctrs_watch_find(struct inode *inode)
+{
+	struct ctrs_watch *watch;
+
+	mutex_lock(&ctrs_watch_mutex);
+	watch = ctrs_find_watch(inode);
+	if (watch)
+		watch->refs++;
+	mutex_unlock(&ctrs_watch_mutex);
+	if (watch)
+		wait_for_completion(&watch->ready);
+	return watch;
+}
+
+struct ctrs_watch *ctrs_watch_get(struct path *path)
+{
+	struct ctrs_watch *watch, *candidate;
+	struct inode *inode = d_inode(path->dentry);
+	bool created = false;
+	int err;
+
+	if (strcmp(inode->i_sb->s_type->name, "virtiofs"))
+		return NULL;
+	if (!ctrs_watch_group)
+		return ERR_PTR(-ENODEV);
+	candidate = kzalloc(sizeof(*candidate), GFP_KERNEL);
+	if (!candidate)
+		return ERR_PTR(-ENOMEM);
+	mutex_lock(&ctrs_watch_mutex);
+	watch = ctrs_find_watch(inode);
+	if (watch) {
+		watch->refs++;
+	} else {
+		watch = candidate;
+		candidate = NULL;
+		watch->inode = inode;
+		watch->names = RB_ROOT;
+		watch->refs = 1;
+		watch->populating = true;
+		mutex_init(&watch->lock);
+		init_completion(&watch->ready);
+		fsnotify_init_mark(&watch->mark, ctrs_watch_group);
+		watch->mark.mask = FS_CREATE | FS_DELETE | FS_MOVED_FROM | FS_MOVED_TO | FS_EVENT_ON_CHILD;
+		hash_add(ctrs_watches, &watch->hash, (unsigned long)inode);
+		created = true;
+	}
+	mutex_unlock(&ctrs_watch_mutex);
+	kfree(candidate);
+	if (created) {
+		err = fsnotify_add_inode_mark(&watch->mark, inode, 0);
+		if (!err)
+			ctrs_watch_populate(watch, path);
+		mutex_lock(&watch->lock);
+		watch->populating = false;
+		{
+			struct rb_node *node = rb_first(&watch->names);
+
+			while (node) {
+				struct ctrs_name *item = rb_entry(node, struct ctrs_name, node);
+
+				node = rb_next(node);
+				if (item->removed) {
+					rb_erase(&item->node, &watch->names);
+					ctrs_name_free(item);
+				}
+			}
+		}
+		mutex_unlock(&watch->lock);
+		watch->error = err;
+		complete_all(&watch->ready);
+	} else {
+		wait_for_completion(&watch->ready);
+	}
+	if (watch->error) {
+		int err = watch->error;
+
+		ctrs_watch_put(watch);
+		return ERR_PTR(err);
+	}
+	return watch;
+}
+
+static int ctrs_watch_handle(struct fsnotify_mark *mark, u32 mask,
+			     struct inode *inode, struct inode *dir,
+			     const struct qstr *name, u32 cookie)
+{
+	struct ctrs_watch *watch = container_of(mark, struct ctrs_watch, mark);
+
+	if (!name || dir != watch->inode)
+		return 0;
+	mutex_lock(&watch->lock);
+	if (mask & (FS_DELETE | FS_MOVED_FROM)) {
+		if (watch->populating) {
+			struct ctrs_name *item = ctrs_name_add_locked(watch, name, 0, mask & FS_ISDIR ? DT_DIR : DT_UNKNOWN, false);
+
+			if (item)
+				item->removed = true;
+		} else {
+			ctrs_name_remove_locked(watch, name);
+		}
+	} else if (mask & (FS_CREATE | FS_MOVED_TO)) {
+		ctrs_name_add_locked(watch, name, inode ? inode->i_ino : 0, mask & FS_ISDIR ? DT_DIR : DT_UNKNOWN, false);
+	}
+	mutex_unlock(&watch->lock);
+	return 0;
+}
+
+static const struct fsnotify_ops ctrs_watch_ops = {
+	.handle_inode_event = ctrs_watch_handle,
+	.free_mark = ctrs_watch_free_mark,
