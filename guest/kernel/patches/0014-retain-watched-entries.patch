+struct ctrs_watch {
+	struct hlist_node hash;
+	struct fsnotify_mark mark;
+	struct mem_cgroup *memcg;
+	struct path path;
+	struct inode *inode;
+	loff_t size;
+	struct timespec64 mtime, ctime;
