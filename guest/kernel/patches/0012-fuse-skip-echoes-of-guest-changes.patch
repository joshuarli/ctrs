 #include <linux/posix_acl.h>
 #include <linux/security.h>
 #include <linux/types.h>
@@ -129,8 +130,24 @@
 	fuse_invalidate_attr_mask(inode, STATX_BASIC_STATS);
 }
 
+void fuse_mark_local_change(struct inode *inode)
+{
+	WRITE_ONCE(get_fuse_inode(inode)->local_change, jiffies);
+}
+
+bool fuse_changed_locally(struct inode *inode, unsigned long window)
+{
+	unsigned long t;
+
+	if (inode->i_sb->s_magic != FUSE_SUPER_MAGIC)
+		return false;
+	t = READ_ONCE(get_fuse_inode(inode)->local_change);
+	return t && time_before(jiffies, t + window);
+}
