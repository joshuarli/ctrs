diff -ru a/fs/proc/ctrs_fsnotify.c b/fs/proc/ctrs_fsnotify.c
--- a/fs/proc/ctrs_fsnotify.c	2026-11-19 02:26:15
+++ b/fs/proc/ctrs_fsnotify.c	2026-11-19 02:26:51
@@ -29,6 +29,37 @@
 #include <linux/string.h>
 #include <linux/uaccess.h>
 
+#define CTRS_ECHO_WINDOW (2 * HZ)
+
+bool fuse_changed_locally(struct inode *inode, unsigned long window);
+
+/*
+ * The host reports every change under a bind source, including the ones
+ * this guest made through virtiofs. Those echoes would drop live dcache
+ * entries and cost a lookup each, so an event is skipped when the name's
+ * cached inode was changed here within the window, when a removed name is
+ * already negative here, or when an uncached removed name's directory was
+ * changed here within the window.
+ */
+static bool local_echo(struct dentry *dir, const char *name, char kind)
+{
+	struct dentry *child = try_lookup_noperm(&QSTR(name), dir);
+	bool echo;
+
+	if (IS_ERR(child))
+		return false;
+	if (!child)
+		return kind == 'r' &&
+		       fuse_changed_locally(d_inode(dir), CTRS_ECHO_WINDOW);
+	if (d_really_is_negative(child))
+		echo = kind == 'r';
+	else
+		echo = kind != 'r' &&
+		       fuse_changed_locally(d_inode(child), CTRS_ECHO_WINDOW);
+	dput(child);
+	return echo;
+}
+
 static bool may_forget(struct dentry *dentry)
 {
 	return !d_mountpoint(dentry) && !d_is_dir(dentry);
