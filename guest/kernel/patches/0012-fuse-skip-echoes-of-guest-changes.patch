 static void fuse_dir_changed(struct inode *dir)
 {
+	fuse_mark_local_change(dir);
 	if (!strcmp(dir->i_sb->s_type->name, "virtiofs"))
 		fuse_invalidate_attr_mask(dir, STATX_BASIC_STATS &
 					  ~(STATX_TYPE | STATX_MODE | STATX_UID |
@@ -733,6 +750,7 @@
 		goto out_err;
 	}
 	kfree(forget);
+	fuse_mark_local_change(inode);
 	if (!strcmp(dir->i_sb->s_type->name, "virtiofs") &&
 	    !(inode->i_mode & (S_ISUID | S_ISGID)))
 		inode->i_flags |= S_NOSEC;
@@ -870,6 +888,7 @@
