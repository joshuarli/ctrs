# Header: the host forwards every FSEvents change under a bind source to
# /proc/ctrs/fsnotify (patch 0006), including the changes this guest made
# itself through virtiofs. During npm install those echoes dropped live
# dcache entries and cost a lookup and an attribute refresh per file.
# FUSE now stamps inodes this guest changes (create, write, setattr,
# rename, directory entry changes), and the proc file skips an event
# whose name's cached inode was changed here within two seconds, whose
# removed name is already negative here, or whose uncached removed name's
# directory was changed here within two seconds.
diff -ru a/fs/fuse/dir.c b/fs/fuse/dir.c
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -17,6 +17,7 @@
 #include <linux/slab.h>
