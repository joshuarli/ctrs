#!/bin/sh
set -eu

if [ ! -r /etc/os-release ]; then
    echo 'setup-dev requires Ubuntu or Debian' >&2
    exit 1
fi
. /etc/os-release
case " ${ID:-} ${ID_LIKE:-} " in
    *' ubuntu '*|*' debian '*) ;;
    *) echo 'setup-dev requires Ubuntu or Debian' >&2; exit 1 ;;
esac

if [ "$(id -u)" -eq 0 ]; then
    apt_cmd=apt-get
else
    if ! command -v sudo >/dev/null 2>&1; then
        echo 'setup-dev requires sudo to install system packages' >&2
        exit 1
    fi
    apt_cmd='sudo apt-get'
fi
$apt_cmd update
$apt_cmd install -y build-essential ca-certificates curl git make python3

if [ ! -x "${CARGO_HOME:-$HOME/.cargo}/bin/rustup" ] && ! command -v rustup >/dev/null 2>&1; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none
fi
PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
export PATH
cd "$(dirname "$0")/.."
rustup toolchain install --profile minimal
cargo fetch --locked
